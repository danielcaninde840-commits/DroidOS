#!/bin/sh
set -e

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --archive-areas "main contrib non-free-firmware" \
  --debian-installer false \
  --bootloaders "grub-efi grub-pc" \
  --linux-flavours amd64 \
  --bootappend-live "boot=live components username=droid hostname=droidos locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Fortaleza" \
  --apt-recommends false \
  --apt-options "--yes -oAcquire::Retries=3" \
  --iso-application "DroidOS Live" \
  --iso-volume "DROIDOS_1_0" \
  --iso-publisher "DroidOS Project" \
  --iso-preparer "DroidOS live-build" \
  --memtest none \
  "${@}"
